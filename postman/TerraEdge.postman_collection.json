{
  "info": {
    "name": "TerraEdge \u2014 Camera Inventory",
    "description": "Proves the access rules live in the API, not the interface.\n\nRUN FOLDER 0 FIRST \u2014 the two login requests save their own tokens.\n\nSAFE TO RUN IN FULL. Every request here is a read or a rejection; none of them change any data. Hit Run on the whole collection and all assertions should pass.\n\nAnything that writes lives in the separate 'TerraEdge \u2014 destructive' collection, so it cannot be triggered by accident.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 \u00b7 Run these first",
      "description": "Both save their token automatically. Check the eye icon afterwards.",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@similipal.test\",\n  \"password\": \"terraedge-admin-2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the token to the right variable based on which account you used.",
                  "const email = JSON.parse(pm.request.body.raw).email;",
                  "const key = email.startsWith(\"admin\") ? \"adminToken\" : \"rangeToken\";",
                  "pm.environment.set(key, pm.response.json().access_token);",
                  "console.log(\"saved \" + key + \" for \" + email);",
                  "pm.test(\"logged in\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Chahala range user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"chahala@similipal.test\",\n  \"password\": \"terraedge-chahala-2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the token to the right variable based on which account you used.",
                  "const email = JSON.parse(pm.request.body.raw).email;",
                  "const key = email.startsWith(\"admin\") ? \"adminToken\" : \"rangeToken\";",
                  "pm.environment.set(key, pm.response.json().access_token);",
                  "console.log(\"saved \" + key + \" for \" + email);",
                  "pm.test(\"logged in\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 \u00b7 A range user cannot see another range's camera",
      "description": "Camera 19 is in Nawana. The range user is Chahala. Same URL, two accounts.",
      "item": [
        {
          "name": "Camera 19 as RANGE USER \u2192 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rangeToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cameras/19",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cameras",
                "19"
              ]
            },
            "description": "404 not 403 on purpose: 403 would confirm the camera exists."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"expects 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Camera 19 as ADMIN \u2192 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cameras/19",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cameras",
                "19"
