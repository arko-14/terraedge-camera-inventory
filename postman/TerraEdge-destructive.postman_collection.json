{
  "info": {
    "name": "TerraEdge \u2014 destructive (run deliberately)",
    "description": "These CHANGE THINGS. Never run this collection during a demo unless you mean to.\n\nFolder 1 transfers camera 15 to Nawana \u2014 reseed the database afterwards:\n  python -m app.seed --reset\n\nFolder 2 logs the admin out and invalidates adminToken \u2014 re-run the Login request afterwards.\n\nNeeds adminToken from the main collection's environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 \u00b7 Log in (same as the main collection)",
      "description": "Both save their token automatically. Check the eye icon afterwards.",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@similipal.test\",\n  \"password\": \"terraedge-admin-2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the token to the right variable based on which account you used.",
                  "const email = JSON.parse(pm.request.body.raw).email;",
                  "const key = email.startsWith(\"admin\") ? \"adminToken\" : \"rangeToken\";",
                  "pm.environment.set(key, pm.response.json().access_token);",
                  "console.log(\"saved \" + key + \" for \" + email);",
                  "pm.test(\"logged in\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Chahala range user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"chahala@similipal.test\",\n  \"password\": \"terraedge-chahala-2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the token to the right variable based on which account you used.",
                  "const email = JSON.parse(pm.request.body.raw).email;",
                  "const key = email.startsWith(\"admin\") ? \"adminToken\" : \"rangeToken\";",
                  "pm.environment.set(key, pm.response.json().access_token);",
                  "console.log(\"saved \" + key + \" for \" + email);",
                  "pm.test(\"logged in\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 \u00b7 History survives a transfer  \u26a0 CHANGES DATA",
      "description": "Only run if asked. Reseed afterwards.",
      "item": [
        {
          "name": "Before: camera 15",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cameras/15",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cameras",
                "15"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"expects 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer it to Nawana",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cameras/15/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cameras",
                "15",
                "transfer"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"range_id\": 2,\n  \"beat_id\": 4,\n  \"note\": \"Moved for the winter census\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"expects 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "History \u2014 old location preserved",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cameras/15/history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cameras",
                "15",
                "history"
              ]
            },
            "description": "The transferred entry keeps from_range, from_beat, from_site and the old coordinates."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"expects 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 \u00b7 Logout revokes tokens  \u26a0 SIGNS YOU OUT",
      "description": "Run in order. Log back in afterwards.",
      "item": [
        {
          "name": "Works before logout \u2192 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"expects 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Log out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"expects 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Same token after logout \u2192 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "A stateless token would normally stay valid until it expired."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"expects 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}