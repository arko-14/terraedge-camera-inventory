# ---------------------------------------------------------------------------
# TerraEdge Camera Inventory - backend environment
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Deployment environment: "development" | "production"
# In production the app refuses to boot with a weak/missing JWT_SECRET.
ENVIRONMENT=development

# --- Database -------------------------------------------------------------
# Local (docker compose up -d db):
DATABASE_URL=postgresql+psycopg://terraedge:terraedge@localhost:5432/terraedge
# Neon / other managed Postgres (note the +psycopg driver and sslmode):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Auth -----------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Cookies / CORS -------------------------------------------------------
# Same-origin or localhost dev  -> COOKIE_SAMESITE=lax,  COOKIE_SECURE=false
# Vercel frontend + Render API  -> COOKIE_SAMESITE=none, COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Comma-separated exact origins allowed to call the API with credentials.
# Wildcards are not permitted when credentials are enabled.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seed data ------------------------------------------------------------
# One password per demo account, created by `python -m app.seed`. Accounts never
# share a credential - the seed script refuses to run if two of these match.
# Demo data is entirely fictional.
#
# Leave BLANK and the seed generates a strong random password per account and
# prints it once, so no weak default is ever baked into the repository.
#
# For a throwaway LOCAL database you may instead set the values the docs and
# scripts/verify_api.sh assume, which keeps the walkthrough copy-pasteable:
#   SEED_ADMIN_PASSWORD=demo-admin-123
#   SEED_CHAHALA_PASSWORD=demo-chahala-123
#   SEED_NAWANA_PASSWORD=demo-nawana-123
# Never use these on a deployed instance - set real values there.
SEED_ADMIN_PASSWORD=
SEED_CHAHALA_PASSWORD=
SEED_NAWANA_PASSWORD=
