# Copy to `.env` (or set in your Vercel project settings).
#
# Leave EMPTY for local development: Vite proxies /api to http://127.0.0.1:8000,
# so the app and API share an origin and no CORS or cross-site cookie is needed.
#
# For a split deployment (frontend on Vercel, API on Render) set the full API
# origin, with no trailing slash:
#   VITE_API_BASE_URL=https://terraedge-api.onrender.com
VITE_API_BASE_URL=
